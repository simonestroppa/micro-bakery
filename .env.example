# Stringa di connessione al database Postgres (es. da Neon: neon.tech).
# Nel dashboard Neon copia la "Connection string" (formato: postgres://utente:password@host/database?sslmode=require)
DATABASE_URL=

# Hash della password admin (generato con: node scripts/hash-password.mjs "tuapassword")
ADMIN_PASSWORD_HASH=

# Stringa segreta casuale lunga per firmare i cookie di sessione admin (es. genera con: openssl rand -base64 32)
SESSION_SECRET=

# Nome del negozio, mostrato nel sito
BAKERY_NAME="La Mia Micro Bakery"

# --- Notifiche nuovo ordine (opzionali, il sito funziona anche senza) ---

# Email dove ricevere notifica nuovo ordine (tua email personale)
NOTIFY_EMAIL_TO=

# Resend.com - per inviare email (piano gratuito disponibile). Lascia vuoto per disattivare le email.
RESEND_API_KEY=
RESEND_FROM="Ordini Bakery <ordini@tuodominio.it>"

# WhatsApp via Twilio (opzionale). Lascia vuoto per disattivare.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
NOTIFY_WHATSAPP_TO="whatsapp:+39XXXXXXXXXX"
